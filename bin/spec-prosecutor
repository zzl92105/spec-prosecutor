#!/usr/bin/env bash

set -euo pipefail

SELF_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SELF_PATH" ]]; do
  LINK_TARGET="$(readlink "$SELF_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SELF_PATH="$LINK_TARGET"
  else
    SELF_PATH="$(cd "$(dirname "$SELF_PATH")" && cd "$(dirname "$LINK_TARGET")" && pwd)/$(basename "$LINK_TARGET")"
  fi
done

ROOT_DIR="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
DEFAULT_MODE="on"
PROJECT_DIR=""
DEFAULT_CURSOR_WORKSPACE="$PWD"
TRIGGER="启动sp"
CLI_INSTALL_ROOT="${HOME}/.local/share/spec-prosecutor"
CLI_BIN_DIR="${HOME}/.local/bin"
CLI_BIN_TARGET="${CLI_BIN_DIR}/spec-prosecutor"
CLI_TARGET_ROOT="${CLI_INSTALL_ROOT}/repo"
if [[ "$ROOT_DIR" == /opt/homebrew/Cellar/spec-prosecutor/*/libexec || "$ROOT_DIR" == /usr/local/Cellar/spec-prosecutor/*/libexec ]]; then
  DEFAULT_SKIP_VALIDATE_REPO=1
else
  DEFAULT_SKIP_VALIDATE_REPO=0
fi
VERSION="$(python3 - <<'PY' "$ROOT_DIR/plugins/spec-prosecutor/plugin.json"
import json
import sys
from pathlib import Path
print(json.loads(Path(sys.argv[1]).read_text())["version"])
PY
)"

usage() {
  cat <<EOF
spec-prosecutor ${VERSION}

Usage:
  spec-prosecutor init [-g|--global] [--codex] [--agent AGENT] [--all] [--mode off|on] [--project PATH] [--cursor-workspace PATH]
  spec-prosecutor add [-g|--global] [--codex] [--agent AGENT] [--all] [--mode off|on] [--project PATH] [--cursor-workspace PATH]
  spec-prosecutor on [-g|--global] [--codex] [--agent AGENT] [--all] [--project PATH] [--cursor-workspace PATH]
  spec-prosecutor off [-g|--global] [--codex] [--agent AGENT] [--all] [--project PATH] [--cursor-workspace PATH]
  spec-prosecutor uninstall [--cli] [-g|--global] [--codex] [--agent AGENT] [--all] [--project PATH] [--cursor-workspace PATH]
  spec-prosecutor remove [--cli] [-g|--global] [--codex] [--agent AGENT] [--all] [--project PATH] [--cursor-workspace PATH]
  spec-prosecutor export [off|on]
  spec-prosecutor doctor
  spec-prosecutor status
  spec-prosecutor version
  spec-prosecutor help

Commands:
  init       Install standalone Skills/rules (not native plugins).
  add        Alias for init.
  on         Switch the selected targets to on mode.
  off        Switch the selected targets to off mode.
  uninstall  Remove installed assets from one or more hosts.
  remove     Alias for uninstall.
  export     Build local install payloads under dist/.
  doctor     Inspect standalone locations and show native plugin commands.
  status     Alias for doctor.
  version    Print the installed Spec Prosecutor version.

Examples:
  bash bin/spec-prosecutor add --codex --claude-code --project /path/to/project
  bash install.sh --codex --mode on       # CLI + Codex
  spec-prosecutor init -g                     # Claude Code
  spec-prosecutor add -g --mode on
  spec-prosecutor on --codex
  spec-prosecutor 开启 --agent cursor --cursor-workspace /path/to/project
  spec-prosecutor init -g --codex            # Codex
  spec-prosecutor init --agent cursor --cursor-workspace /path/to/project
  spec-prosecutor remove --codex --cli
EOF
}

die() {
  echo "$*" >&2
  exit 1
}

require_runtime() {
  command -v python3 >/dev/null || die "Standalone Skill installation requires Python 3.9+. Native plugins do not need this script."
}

set_target_by_agent() {
  local agent="$1"
  case "$agent" in
    claude-code|claude)
      TARGET_CLAUDE=true
      ;;
    codex)
      TARGET_CODEX=true
      ;;
    cursor)
      TARGET_CURSOR=true
      ;;
    gemini|windsurf|cline|roo|roo-code|kilocode|antigravity)
      die "Agent '$agent' is not supported yet. Supported agents: claude-code, codex, cursor."
      ;;
    *)
      die "Unknown agent: $agent. Supported agents: claude-code, codex, cursor."
      ;;
  esac
}

ensure_target_selected() {
  if [[ "$TARGET_ALL" == false && "$TARGET_CODEX" == false && "$TARGET_CLAUDE" == false && "$TARGET_CURSOR" == false ]]; then
    die "Choose --codex, --claude-code, --cursor or --all. This command installs standalone Skills; see README.md for native plugins."
  fi

  if [[ "$TARGET_ALL" == true ]]; then
    TARGET_CODEX=true
    TARGET_CLAUDE=true
    TARGET_CURSOR=true
  fi
}

copy_dir() {
  local src="$1"
  local dest="$2"
  [[ ! -L "$dest" ]] || die "Refusing to overwrite a symlink: $dest"
  mkdir -p "$dest"
  cp -R "$src/." "$dest/"
}

install_codex() {
  local mode="$1"
  local dest="${PROJECT_DIR:-$HOME}/.agents/skills/spec-prosecutor"
  bash "$ROOT_DIR/scripts/export-codex-skill.sh" "$mode" >/dev/null
  copy_dir "$ROOT_DIR/dist/codex-skill/$mode/spec-prosecutor" "$dest"
  echo "Installed Codex skill to $dest ($mode mode)"
}

install_claude() {
  local mode="$1"
  local dest="${PROJECT_DIR:-$HOME}/.claude/skills/spec-prosecutor"
  bash "$ROOT_DIR/scripts/export-claude-code-skill.sh" "$mode" >/dev/null
  copy_dir "$ROOT_DIR/dist/claude-code/$mode/spec-prosecutor" "$dest"
  echo "Installed Claude Code skill to $dest ($mode mode)"
}

install_cursor() {
  local mode="$1"
  local workspace="$2"
  local workspace_abs
  workspace_abs="$(cd "$workspace" && pwd)"
  local dest="$workspace_abs/.cursor/rules/spec-prosecutor.mdc"
  bash "$ROOT_DIR/scripts/export-cursor-rule.sh" "$mode" >/dev/null
  mkdir -p "$(dirname "$dest")"
  cp "$ROOT_DIR/dist/cursor/$mode/spec-prosecutor.mdc" "$dest"
  echo "Installed Cursor rule to $dest ($mode mode)"
}

uninstall_codex() {
  local dest="${PROJECT_DIR:-$HOME}/.agents/skills/spec-prosecutor"
  if [[ -e "$dest" ]]; then
    rm -rf "$dest"
    echo "Removed Codex skill from $dest"
  else
    echo "Codex skill not installed at $dest"
  fi
}

uninstall_claude() {
  local dest="${PROJECT_DIR:-$HOME}/.claude/skills/spec-prosecutor"
  if [[ -e "$dest" ]]; then
    rm -rf "$dest"
    echo "Removed Claude Code skill from $dest"
  else
    echo "Claude Code skill not installed at $dest"
  fi
}

uninstall_cursor() {
  local workspace="$1"
  local workspace_abs
  workspace_abs="$(cd "$workspace" && pwd)"
  local dest="$workspace_abs/.cursor/rules/spec-prosecutor.mdc"
  if [[ -e "$dest" ]]; then
    rm -f "$dest"
    echo "Removed Cursor rule from $dest"
  else
    echo "Cursor rule not installed at $dest"
  fi
}

uninstall_cli() {
  if [[ -L "$CLI_BIN_TARGET" || -e "$CLI_BIN_TARGET" ]]; then
    rm -f "$CLI_BIN_TARGET"
    echo "Removed CLI binary from $CLI_BIN_TARGET"
  else
    echo "CLI binary not installed at $CLI_BIN_TARGET"
  fi

  if [[ -e "$CLI_TARGET_ROOT" ]]; then
    rm -rf "$CLI_TARGET_ROOT"
    echo "Removed CLI payload from $CLI_TARGET_ROOT"
  else
    echo "CLI payload not installed at $CLI_TARGET_ROOT"
  fi
}

doctor() {
  python3 "$ROOT_DIR/scripts/doctor.py"
  cat <<EOF
spec-prosecutor doctor

Version:
  $VERSION

Standalone Skill targets (separate from native plugins):
  CLI:         $CLI_BIN_TARGET
  Codex:       $HOME/.agents/skills/spec-prosecutor
  Claude Code: $HOME/.claude/skills/spec-prosecutor
  Cursor:      <workspace>/.cursor/rules/spec-prosecutor.mdc

Optional legacy alias (Codex and Claude Code):
  $TRIGGER

Supported agents:
  claude-code, codex, cursor
EOF
}

print_init_next_steps() {
  local mode="$1"
  cat <<EOF

Next steps:
  spec-prosecutor doctor
EOF

  if [[ "$mode" == "on" ]]; then
    cat <<EOF
  Optional legacy alias (Codex and Claude Code):
    $TRIGGER
EOF
  fi
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  add) command="init" ;;
  on|enable|开启) command="init"; set -- --mode on "$@" ;;
  off|disable|关闭) command="init"; set -- --mode off "$@" ;;
  remove) command="uninstall" ;;
  status) command="doctor" ;;
  i) command="init" ;;
  x|rm) command="uninstall" ;;
  d) command="doctor" ;;
  v) command="version" ;;
esac

case "$command" in
  init)
    require_runtime
    TARGET_ALL=false
    TARGET_CODEX=false
    TARGET_CLAUDE=false
    TARGET_CURSOR=false
    GLOBAL_TARGET=false
    MODE="$DEFAULT_MODE"
    CURSOR_WORKSPACE="$DEFAULT_CURSOR_WORKSPACE"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --all) TARGET_ALL=true ;;
        -g|--global) GLOBAL_TARGET=true ;;
        --codex) TARGET_CODEX=true ;;
        --claude-code) TARGET_CLAUDE=true ;;
        --cursor) TARGET_CURSOR=true ;;
        --agent)
          shift
          [[ $# -gt 0 ]] || die "--agent requires a value"
          set_target_by_agent "$1"
          ;;
        --mode)
          shift
          [[ $# -gt 0 ]] || die "--mode requires off or on"
          MODE="$1"
          ;;
        --project)
          shift
          [[ $# -gt 0 && -n "$1" ]] || die "--project requires a path"
          [[ -d "$1" ]] || die "Project directory does not exist: $1"
          PROJECT_DIR="$(cd "$1" && pwd)"
          ;;
        --cursor-workspace)
          shift
          [[ $# -gt 0 ]] || die "--cursor-workspace requires a path"
          CURSOR_WORKSPACE="$1"
          ;;
        *)
          die "Unknown init option: $1"
          ;;
      esac
      shift
    done
    [[ "$MODE" == "off" || "$MODE" == "on" ]] || die "--mode must be off or on"
    if [[ "$GLOBAL_TARGET" == true && "$TARGET_CODEX" == false && "$TARGET_CLAUDE" == false && "$TARGET_CURSOR" == false && "$TARGET_ALL" == false ]]; then
      TARGET_CLAUDE=true
    fi
    if [[ -n "$PROJECT_DIR" ]]; then
      [[ "$GLOBAL_TARGET" == false ]] || die "--project and --global cannot be combined"
      [[ "$TARGET_ALL" == false && "$TARGET_CURSOR" == false ]] || die "--project supports --codex and --claude-code only"
      [[ "$TARGET_CODEX" == true || "$TARGET_CLAUDE" == true ]] || die "Choose --codex and/or --claude-code with --project"
    fi
    ensure_target_selected
    [[ ! "$TARGET_CURSOR" == true || -d "$CURSOR_WORKSPACE" ]] || die "Cursor workspace does not exist: $CURSOR_WORKSPACE"
    if [[ "${SP_SKIP_VALIDATE_REPO:-$DEFAULT_SKIP_VALIDATE_REPO}" != "1" ]]; then
      python3 "$ROOT_DIR/scripts/sync-metadata.py" --check >/dev/null
    fi
    [[ "$TARGET_CODEX" == true ]] && install_codex "$MODE"
    [[ "$TARGET_CLAUDE" == true ]] && install_claude "$MODE"
    [[ "$TARGET_CURSOR" == true ]] && install_cursor "$MODE" "$CURSOR_WORKSPACE"
    echo "Spec Prosecutor init complete."
    print_init_next_steps "$MODE"
    ;;
  uninstall)
    require_runtime
    TARGET_ALL=false
    TARGET_CODEX=false
    TARGET_CLAUDE=false
    TARGET_CURSOR=false
    TARGET_CLI=false
    GLOBAL_TARGET=false
    CURSOR_WORKSPACE="$DEFAULT_CURSOR_WORKSPACE"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --all) TARGET_ALL=true; TARGET_CLI=true ;;
        --cli) TARGET_CLI=true ;;
        -g|--global) GLOBAL_TARGET=true ;;
        --codex) TARGET_CODEX=true ;;
        --claude-code) TARGET_CLAUDE=true ;;
        --cursor) TARGET_CURSOR=true ;;
        --agent)
          shift
          [[ $# -gt 0 ]] || die "--agent requires a value"
          set_target_by_agent "$1"
          ;;
        --project)
          shift
          [[ $# -gt 0 && -n "$1" ]] || die "--project requires a path"
          [[ -d "$1" ]] || die "Project directory does not exist: $1"
          PROJECT_DIR="$(cd "$1" && pwd)"
          ;;
        --cursor-workspace)
          shift
          [[ $# -gt 0 ]] || die "--cursor-workspace requires a path"
          CURSOR_WORKSPACE="$1"
          ;;
        *)
          die "Unknown uninstall option: $1"
          ;;
      esac
      shift
    done
    if [[ "$GLOBAL_TARGET" == true && "$TARGET_CODEX" == false && "$TARGET_CLAUDE" == false && "$TARGET_CURSOR" == false && "$TARGET_ALL" == false ]]; then
      TARGET_CLAUDE=true
    fi
    if [[ -n "$PROJECT_DIR" ]]; then
      [[ "$GLOBAL_TARGET" == false ]] || die "--project and --global cannot be combined"
      [[ "$TARGET_ALL" == false && "$TARGET_CURSOR" == false ]] || die "--project supports --codex and --claude-code only"
      [[ "$TARGET_CODEX" == true || "$TARGET_CLAUDE" == true ]] || die "Choose --codex and/or --claude-code with --project"
    fi
    if [[ "$TARGET_CLI" == false || "$TARGET_ALL" == true ]]; then
      ensure_target_selected
    fi
    [[ -z "$PROJECT_DIR" || "$TARGET_CLI" == false ]] || die "--cli cannot be combined with --project"
    [[ "$TARGET_CODEX" == true ]] && uninstall_codex
    [[ "$TARGET_CLAUDE" == true ]] && uninstall_claude
    [[ "$TARGET_CURSOR" == true ]] && uninstall_cursor "$CURSOR_WORKSPACE"
    [[ "$TARGET_CLI" == true ]] && uninstall_cli
    echo "Spec Prosecutor uninstall complete."
    ;;
  export)
    require_runtime
    MODE="${1:-on}"
    [[ "$MODE" == "off" || "$MODE" == "on" ]] || die "export mode must be off or on"
    bash "$ROOT_DIR/scripts/export-codex-skill.sh" "$MODE" >/dev/null
    bash "$ROOT_DIR/scripts/export-plugin.sh" "$MODE" >/dev/null
    bash "$ROOT_DIR/scripts/export-claude-code-skill.sh" "$MODE" >/dev/null
    bash "$ROOT_DIR/scripts/export-cursor-rule.sh" "$MODE" >/dev/null
    echo "Exported $MODE-mode install payloads under $ROOT_DIR/dist"
    ;;
  doctor)
    doctor
    ;;
  version|--version|-v)
    echo "$VERSION"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    die "Unknown command: $command"
    ;;
esac
